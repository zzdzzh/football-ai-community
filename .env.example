# Docker Compose Environment Variables
# Copy this file to .env and fill in your values

# JWT Secret (required for production)
JWT_SECRET=your-production-jwt-secret-change-this

# Admin credentials (required)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# AI Configuration (required for AI features)
# Example: ZhipuAI BigModel (OpenAI-compatible)
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_API_KEY=your-api-key-here
AI_MODEL=glm-4.7-flash
AI_TIMEOUT_MS=120000

# Interactive AI (optional, defaults to AI_* values)
AI_INTERACTIVE_API_KEY=your-interactive-api-key
AI_INTERACTIVE_MODEL=glm-5.1

# Internal API Key for job triggers
INTERNAL_API_KEY=your-internal-api-key

# Data Source: football-data (recommended for Docker) or scraper
DATA_SOURCE=football-data

# football-data.org API (required if DATA_SOURCE=football-data)
FOOTBALL_DATA_API_KEY=your-football-data-api-key
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# Player relationship analysis settings
CAREER_SYNC_TTL_DAYS=7
RELATIONSHIP_MAX_HOPS=6
CAREER_SYNC_TIMEOUT_MS=60000
